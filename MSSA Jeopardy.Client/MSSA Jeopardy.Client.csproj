<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Keep the assembly name URL/asset friendly (no spaces / punctuation) -->
		<AssemblyName>MSSA_Jeopardy.Client</AssemblyName>
		<RootNamespace>MSSA_Jeopardy.Client</RootNamespace>

		<!-- Avoid the "conflicting _framework/*.pdb" build error -->
		<BlazorWebAssemblyDebugSymbols>false</BlazorWebAssemblyDebugSymbols>

		<!-- Prevent the SDK from trying to pre-compress static web assets -->
		<EnableCompressionInStaticWebAssets>false</EnableCompressionInStaticWebAssets>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.0" PrivateAssets="all" />
		<Compile Include="MSSA_Jeopardy.Client\Services\JeopardyGameService.cs" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Models\" />
	  <Folder Include="Services\" />
	  <Folder Include="wwwroot\" />
	</ItemGroup>

</Project>
