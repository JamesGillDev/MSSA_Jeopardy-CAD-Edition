<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MSSA_Jeopardy.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>MSSA Jeopardy Desktop</ApplicationTitle>
    <ApplicationId>com.jamesgilldev.mssa_jeopardy.desktop</ApplicationId>
    <Version>2.4.1</Version>
    <AssemblyVersion>2.4.1.0</AssemblyVersion>
    <FileVersion>2.4.1.0</FileVersion>
    <InformationalVersion>2.4.1</InformationalVersion>
    <ApplicationDisplayVersion>2.4.1</ApplicationDisplayVersion>
    <ApplicationVersion>241</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\appicon.svg" ForegroundFile="Resources\appiconfg.svg" Color="#0f2f86" />
    <MauiSplashScreen Include="Resources\appiconfg.svg" Color="#0f2f86" BaseSize="128,128" />
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />
    <MauiFont Include="Resources\Fonts\*" />
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\JeopardyGameService.Shared.cs" Link="Services\JeopardyGameService.Shared.cs" />
    <Compile Include="..\MSSA Jeopardy\Models\JeopardyQuestion.cs" Link="Models\JeopardyQuestion.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.100" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="8.0.100" />
  </ItemGroup>

  <Target Name="IncludeMauiCssInScopedCssInputs" BeforeTargets="ResolveScopedCssInputs">
    <!-- MAUI classifies *.razor.css as MauiCss, but scoped CSS discovery reads None/Content. -->
    <ItemGroup>
      <ScopedCssInput Include="@(MauiCss)" />
    </ItemGroup>
  </Target>

</Project>
