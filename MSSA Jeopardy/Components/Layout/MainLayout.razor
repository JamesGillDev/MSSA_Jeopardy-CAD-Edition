@inherits LayoutComponentBase

<div class="page">
    <header class="top-ribbon">
        <div class="top-ribbon-inner px-4">
            <NavMenu />
            <a href="https://github.com/JamesGillDev/MSSA_Jeopardy-CAD-Edition#readme" target="_blank">About</a>
        </div>
    </header>

    <main>
        <article class="content px-4">
