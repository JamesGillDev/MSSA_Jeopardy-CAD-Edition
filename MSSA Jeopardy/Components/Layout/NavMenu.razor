@inject IJSRuntime JS

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MSSA Jeopardy!</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="PlayWelcomeVoice">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="jeopardy" @onclick="PlayBoardSetupVoice">
                <span class="bi bi-grid-fill-nav-menu" aria-hidden="true"></span> Play Jeopardy!
            </NavLink>
        </div>
    </nav>
</div>

@code {
    private async Task PlayWelcomeVoice()
    {
        try
        {
            await JS.InvokeVoidAsync("playWelcomeVoice");
        }
        catch (JSException)
        {
            // No-op: speech support can vary by browser.
        }
    }

    private async Task PlayBoardSetupVoice()
    {
        try
        {
            await JS.InvokeVoidAsync("jeopardyPlayClip", "board-setup");
        }
        catch (JSException)
        {
            // No-op: navigation should still continue if audio fails.
        }
    }
}
