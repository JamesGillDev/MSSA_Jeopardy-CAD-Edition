@inject IJSRuntime JS

<nav class="ribbon-nav" aria-label="Primary">
    <a class="ribbon-brand" href="">MSSA Jeopardy!</a>

    <div class="ribbon-links">
        <NavLink class="ribbon-link" href="" Match="NavLinkMatch.All">
            <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
            <span>Home</span>
        </NavLink>

        <NavLink class="ribbon-link ribbon-link-play" href="jeopardy" @onclick="PlayBoardSetupVoice">
            <span class="bi bi-grid-fill-nav-menu" aria-hidden="true"></span>
            <span>Play Jeopardy!</span>
        </NavLink>
    </div>
</nav>

@code {
    private async Task PlayBoardSetupVoice()
    {
        try
        {
            await JS.InvokeVoidAsync("playBoardSetupVoice");
        }
        catch (JSException)
        {
            // No-op: navigation should still continue if audio fails.
        }
    }
}
