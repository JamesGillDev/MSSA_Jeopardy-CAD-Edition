@page "/"

<PageTitle>MSSA Jeopardy - Home</PageTitle>

@using MSSA_Jeopardy.Services
@inject IJSRuntime JS

<div class="home-container">
    <div class="home-header">
        <h1>MSSA Jeopardy</h1>
        <p class="subtitle">Test your knowledge. Play like the TV show!</p>
    </div>
    <div class="home-actions">
        <a class="play-btn" href="/jeopardy">Play Jeopardy</a>
    </div>
    <div class="category-preview">
        <h3>Sample Categories</h3>
        <div class="category-preview-grid">
            @foreach (var cat in JeopardyGameService.AllCategoryNames.Take(6))
            {
                <div class="category-preview-card">@cat</div>
            }
        </div>
    </div>
</div>

<style>
.home-container {
    max-width: 900px;
    margin: 2rem auto;
    padding: 2rem;
    background: linear-gradient(180deg, #0a1f68 0%, #081745 100%);
    border-radius: 16px;
    color: #fff;
    box-shadow: 0 0 24px #173fae;
}
.home-header h1 {
    font-family: 'Oswald', 'Arial Black', sans-serif;
    font-size: 2.5rem;
    color: #f9b017;
    text-shadow: 2px 2px 8px #173fae;
}
.subtitle {
    font-size: 1.2rem;
    color: #fff;
    margin-bottom: 1.5rem;
}
.home-actions {
    margin: 2rem 0;
    text-align: center;
}
.play-btn {
    background: #f9b017;
    color: #173fae;
    font-size: 1.3rem;
    font-weight: bold;
    padding: 1rem 2.5rem;
    border-radius: 12px;
    text-decoration: none;
    box-shadow: 0 0 12px #f9b017;
}
.category-preview {
    margin-top: 2rem;
}
.category-preview-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 1rem;
}
.category-preview-card {
    background: #173fae;
    color: #fff;
    border-radius: 8px;
    padding: 1rem;
    font-size: 1.1rem;
    font-family: 'Oswald', 'Arial Black', sans-serif;
    text-align: center;
    box-shadow: 0 0 8px #173fae;
}
</style>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("playWelcomeVoice");
            }
            catch (JSException)
            {
                // No-op: app should still render even if speech is unavailable.
            }
        }
    }
}
