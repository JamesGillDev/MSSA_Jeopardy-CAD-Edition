@page "/jeopardy"
@using MSSA_Jeopardy.Models
@inject JeopardyGameService GameService

<PageTitle>MSSA Jeopardy!</PageTitle>

@if (!GameService.GameStarted)
{
    <section class="setup-panel">
        <h2>Select Categories</h2>
        <p>Select up to 6 categories to play:</p>
        <div class="category-picker">
            @foreach (var cat in JeopardyGameService.AllCategoryNames)
            {
                var isSelected = GameService.SelectedCategories.Contains(cat);
                <label class="category-option @(isSelected ? "selected" : string.Empty)">
                    <input type="checkbox"
                           value="@cat"
                           @onchange="e => OnCategoryChanged(e, cat)"
                           checked="@isSelected"
                           disabled="@(!isSelected && GameService.SelectedCategories.Count >= 6)" />
                    <span>@cat</span>
                </label>
            }
        </div>
        <div class="setup-actions">
            <span>@GameService.SelectedCategories.Count / 6 selected</span>
            <button class="start-game-btn" @onclick="StartGame" disabled="@(GameService.SelectedCategories.Count == 0)">Start Game</button>
        </div>
    </section>
}
else
{
    <section class="game-shell">
        <div class="board-header">
            <h2>Game Board</h2>
            <div class="player-turn">Current Player: <strong>@GameService.PlayerNames[GameService.CurrentPlayer]</strong></div>
        </div>

        <div class="score-strip">
            @foreach (var player in GameService.PlayerNames)
            {
                <div class="score-card @(player.Key == GameService.CurrentPlayer ? "active" : string.Empty)">
                    <span class="player-name">@player.Value</span>
                    <span class="player-score">@GameService.PlayerScores[player.Key]</span>
                </div>
            }
        </div>

        <div class="jeopardy-board" style="--column-count:@GameService.Categories.Count;">
            @foreach (var cat in GameService.Categories)
            {
                <section class="category-column">
                    <div class="category-title">@cat.Name</div>
                    @foreach (var q in cat.Questions.OrderBy(x => x.PointValue))
                    {
                        <button class="clue-tile @(q.IsAnswered ? "answered" : string.Empty)"
                                @onclick="() => SelectQuestion(q)"
                                disabled="@q.IsAnswered">
                            @if (!q.IsAnswered)
                            {
                                <span>$@q.PointValue</span>
                            }
                            else
                            {
                                <span>&nbsp;</span>
                            }
                        </button>
                    }
                </section>
            }
        </div>

        @if (GameService.CurrentQuestion != null)
        {
            <div class="question-modal">
                <div class="question-tv">
                    <div class="question-text">@GameService.CurrentQuestion.Question</div>
                    <div class="answer-input-strip">
                        <h4>@GameService.PlayerNames[GameService.CurrentPlayer] is answering:</h4>
                        <button class="score-btn correct" @onclick="() => AnswerQuestion(true)">Correct</button>
                        <button class="score-btn incorrect" @onclick="() => AnswerQuestion(false)">Incorrect</button>
                    </div>
                </div>
                <button class="close-btn" @onclick="CloseQuestion">Close</button>
            </div>
        }
    </section>
}

@code {
    private void OnCategoryChanged(ChangeEventArgs e, string cat)
    {
        if (e.Value is bool isChecked && isChecked)
        {
            if (!GameService.SelectedCategories.Contains(cat) && GameService.SelectedCategories.Count < 6)
                GameService.SelectedCategories.Add(cat);
        }
        else
        {
            GameService.SelectedCategories.Remove(cat);
        }
    }

    private void StartGame()
    {
        GameService.SetSelectedCategories(GameService.SelectedCategories);
        GameService.StartGame();
        StateHasChanged();
    }

    private void SelectQuestion(JeopardyQuestion q)
    {
        GameService.SelectQuestion(q);
        StateHasChanged();
    }

    private void AnswerQuestion(bool correct)
    {
        GameService.AnswerQuestion(correct, GameService.CurrentPlayer);
        StateHasChanged();
    }

    private void CloseQuestion()
    {
        GameService.CloseQuestion();
        StateHasChanged();
    }

}

