<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="MSSA_Jeopardy.styles.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="audio.js?v=20260224e"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (() => {
            const reloadGuardKey = "mssa-jeopardy:startup-auto-reload";

            Blazor.start({
                circuit: {
                    reconnectionOptions: {
                        maxRetries: 8,
                        retryIntervalMilliseconds: Array.prototype.at.bind([0, 1000, 2000, 5000, 10000, 15000, 30000])
                    }
                }
            }).then(() => {
                sessionStorage.removeItem(reloadGuardKey);
            }).catch((error) => {
                console.error("Blazor startup failed.", error);

                // Recover once for transient first-start failures (cold start/network race).
                if (sessionStorage.getItem(reloadGuardKey) !== "1") {
                    sessionStorage.setItem(reloadGuardKey, "1");
                    location.reload();
                    return;
                }

                const errorUi = document.getElementById("blazor-error-ui");
                if (errorUi && errorUi.style.display === "none") {
                    errorUi.style.display = "block";
                }
            });
        })();
    </script>
</body>
</html>
