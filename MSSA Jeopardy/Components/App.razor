@using Microsoft.AspNetCore.Components.Web
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@using MSSA_Jeopardy.Components

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link rel="stylesheet" href="lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="MSSA_Jeopardy.styles.css" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="audio.js?v=2.3.3"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script>
        (() => {
            const startupReloadGuardKey = "mssa-jeopardy:startup-auto-reload";
            const errorUiReloadGuardKey = "mssa-jeopardy:error-ui-auto-reload";
            const appStartMs = Date.now();
            const retrySchedule = [0, 1000, 2000, 5000, 10000, 15000, 30000];
            const isFirefox = /firefox/i.test(navigator.userAgent || "");
            const guardMemory = {
                startup: false,
                errorUi: false
            };

            const getStorage = () => {
                try {
                    return window.sessionStorage;
                } catch {
                    return null;
                }
            };

            const readGuard = (key) => {
                const storage = getStorage();
                if (!storage) {
                    return null;
                }

                try {
                    return storage.getItem(key);
                } catch {
                    return null;
                }
            };

            const writeGuard = (key, value) => {
                const storage = getStorage();
                if (!storage) {
                    return;
                }

                try {
                    storage.setItem(key, value);
                } catch {
                    // Ignore storage write errors (Firefox privacy mode, blocked storage, etc.).
                }
            };

            const removeGuard = (key) => {
                const storage = getStorage();
                if (!storage) {
                    return;
                }

                try {
                    storage.removeItem(key);
                } catch {
                    // Ignore storage remove errors.
                }
            };

            const hasGuard = (kind, key) => guardMemory[kind] || readGuard(key) === "1";
            const markGuard = (kind, key) => {
                guardMemory[kind] = true;
                writeGuard(key, "1");
            };
            const clearGuard = (kind, key) => {
                guardMemory[kind] = false;
                removeGuard(key);
            };

            const maybeAutoReloadFromErrorUi = () => {
                const errorUi = document.getElementById("blazor-error-ui");
                if (!errorUi) {
                    return;
                }

                const style = window.getComputedStyle(errorUi);
                const isVisible = style.display !== "none" && style.visibility !== "hidden";
                if (!isVisible) {
                    return;
                }

                // Target startup/cold-start failures only.
                if (Date.now() - appStartMs > 60000) {
                    return;
                }

                if (hasGuard("errorUi", errorUiReloadGuardKey)) {
                    return;
                }

                markGuard("errorUi", errorUiReloadGuardKey);
                location.reload();
            };

            const attachErrorUiObserver = () => {
                const errorUi = document.getElementById("blazor-error-ui");
                if (!errorUi) {
                    return false;
                }

                const observer = new MutationObserver(maybeAutoReloadFromErrorUi);
                observer.observe(errorUi, { attributes: true, attributeFilter: ["style", "class"] });

                // Defensive poll in case visibility changes without attribute mutation.
                window.setInterval(maybeAutoReloadFromErrorUi, 1000);
                maybeAutoReloadFromErrorUi();
                return true;
            };

            if (!attachErrorUiObserver()) {
                const attachAttempts = window.setInterval(() => {
                    if (attachErrorUiObserver()) {
                        window.clearInterval(attachAttempts);
                    }
                }, 500);

                window.setTimeout(() => window.clearInterval(attachAttempts), 15000);
            }

            Blazor.start({
                circuit: {
                    configureSignalR: (builder) => {
                        try {
                            builder.withServerTimeout(60000);
                            builder.withKeepAliveInterval(15000);

                            // Firefox can be less stable when repeatedly negotiating non-WebSocket fallbacks.
                            // Prefer long polling there for consistent startup behavior.
                            if (isFirefox && typeof builder.withUrl === "function") {
                                builder.withUrl("_blazor", 4);
                            }
                        } catch (error) {
                            console.warn("SignalR client tuning skipped.", error);
                        }
                    },
                    reconnectionOptions: {
                        maxRetries: 8,
                        retryIntervalMilliseconds: (previousAttempts) => retrySchedule[previousAttempts] ?? 30000
                    }
                }
            }).then(() => {
                clearGuard("startup", startupReloadGuardKey);
                clearGuard("errorUi", errorUiReloadGuardKey);
            }).catch((error) => {
                console.error("Blazor startup failed.", error);

                if (!hasGuard("startup", startupReloadGuardKey)) {
                    markGuard("startup", startupReloadGuardKey);
                    location.reload();
                    return;
                }

                const errorUi = document.getElementById("blazor-error-ui");
                if (errorUi) {
                    errorUi.style.display = "block";
                }
            });
        })();
    </script>
</body>
</html>
