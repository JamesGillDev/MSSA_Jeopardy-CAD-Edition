<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Keep the assembly name URL/asset friendly (no spaces / punctuation) -->
		<AssemblyName>MSSA_Jeopardy</AssemblyName>
		<RootNamespace>MSSA_Jeopardy</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\Shared\JeopardyGameService.Shared.cs" Link="Services\JeopardyGameService.Shared.cs" />
	</ItemGroup>

</Project>
