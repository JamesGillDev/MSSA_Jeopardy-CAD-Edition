		<RootNamespace>MSSA_Jeopardy</RootNamespace>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Services\JeopardyGameService.cs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="8.0.0" />
		<PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="8.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\MSSA Jeopardy.Client\MSSA Jeopardy.Client.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Services\" />
	</ItemGroup>

</Project>
